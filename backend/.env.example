# consult-service backend 環境變數範本（複製成 backend/.env）
# main.py 以 load_dotenv() 載入。

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB=consult_service

# --- 表單送出後通知 LINE bot（StyleMate LineBot 的 /hooks/form-submitted）---
# 顧客從 LINE 聊天室的預約按鈕開表單時，網址帶 ?uid=<LINE userId>，會存進
# responses.line_uid。表單送出後，後端會把姓名/電話/服務項目/摘要 POST 給 LINE
# bot，讓 bot 在 LINE 對話裡接續預約。三個都設定好才會啟用（缺一則靜默略過）。
# best-effort：通知失敗不影響表單送出。
LINEBOT_HOOK_URL=http://localhost:8000/hooks/form-submitted
LINEBOT_HOOK_TOKEN=          # 要與 LINE bot 的 FORM_HOOK_TOKEN 一致
LINEBOT_TENANT=default       # 這個表單對應到 LINE bot 的哪一家店

# --- 表單最後一步的「選預約時間」，串接 calendar-service ---
# 讀營業時間/既有預約/服務時長設定走同一個 Mongo cluster 直接讀（跟
# calendar-service 讀 consult-service 的方式對稱），CALENDAR_MONGO_DB 是
# calendar-service 自己的 database 名稱。真正建立預約則是打 calendar-service
# 的登入後 API（跟 skills/calendar-booking/mcp-server 用同一組帳密），讓
# calendar-service 自己的營業時間/cutoff/衝突驗證把關，這裡不重工。
# calendar-service 目前只有一個老闆帳號，所有預約（不管從 LINE 還是這個表單
# 來的）都是同一個帳號名下——CALENDAR_OWNER_EMAIL/PASSWORD 就是那組帳密。
CALENDAR_MONGO_DB=calendar_service
CALENDAR_BASE_URL=http://localhost:3001
CALENDAR_OWNER_EMAIL=admin@example.com
CALENDAR_OWNER_PASSWORD=12345678
